{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "VisualEditor0",
			"Effect": "Allow",
			"Action": [
				"s3:ReplicateObject",
				"s3:PutObject",
				"s3:GetObject",
				"s3:RestoreObject",
				"s3:GetObjectAttributes",
				"s3:GetObjectTagging",
				"s3:DeleteObject",
				"s3:GetObjectVersion"
			],
			"Resource": [
				"arn:aws:s3:::*/*",
				"arn:aws:s3:*:081348549363:accesspoint/*/object/*"
			]
		},
		{
			"Sid": "VisualEditor1",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucketVersions",
				"s3:ListBucket",
				"s3:GetBucketNotification",
				"s3:DeleteBucket",
				"s3:CreateBucket",
				"s3:GetBucketPolicy",
				"s3:GetBucketAcl",
				"s3:GetBucketCORS",
				"s3:GetBucketWebsite",
				"s3:GetBucketVersioning",
				"s3:GetAccelerateConfiguration",
				"s3:GetBucketRequestPayment",
				"s3:GetBucketLogging",
				"s3:GetLifecycleConfiguration",
				"s3:GetReplicationConfiguration",
				"s3:GetEncryptionConfiguration",
				"s3:GetBucketObjectLockConfiguration",
				"s3:GetBucketTagging",
				"s3:PutBucketTagging",
				"s3:PutBucketVersioning"
			],
			"Resource": [
				"arn:aws:s3:::*",
				"arn:aws:s3:*:081348549363:accesspoint/*"
			]
		},
		{
			"Sid": "VisualEditor2",
			"Effect": "Allow",
			"Action": "s3:ListAllMyBuckets",
			"Resource": "*"
		}
	]
}